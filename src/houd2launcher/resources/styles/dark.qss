QWidget {
    background: #111820;
    color: #dce2e5;
    font-size: 14px;
    font-weight: 500;
}

QMainWindow, QMenuBar, QMenu, QStatusBar {
    background: #0d141b;
    color: #dce2e5;
}

QProgressBar {
    min-height: 20px;
    background: #0b1117;
    color: #f3f6f4;
    border: 1px solid #34434e;
    border-radius: 4px;
    text-align: center;
    font-weight: 600;
}

QProgressBar::chunk {
    background: #9b8248;
    border-radius: 3px;
}

QMenuBar::item:selected, QMenu::item:selected {
    background: #27333d;
}

#ProjectPanel {
    background: #131c24;
    border-right: 1px solid #34434e;
}

#PanelTitle {
    font-size: 17px;
    font-weight: 600;
    color: #edf1f2;
}

#ItemTitle {
    font-size: 14px;
    font-weight: 600;
    color: #edf1f2;
}

#SecondaryText, #FieldHelp {
    color: #9da9b0;
    font-size: 12px;
}

QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox,
QTableWidget, QTreeWidget, QListWidget, QTabWidget::pane {
    background: #1b2731;
    color: #f0f2f1;
    border: 1px solid #394955;
    border-radius: 4px;
    selection-background-color: #4a412a;
    selection-color: #ffffff;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    min-height: 30px;
    padding: 2px 7px;
}

QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QTableWidget:focus, QTreeWidget:focus, QListWidget:focus {
    border: 1px solid #b79a53;
}

QPushButton, QToolButton {
    background: #202c35;
    color: #f3f5f4;
    border: 1px solid #3d4c57;
    border-radius: 4px;
    min-height: 30px;
    padding: 3px 10px;
    font-weight: 600;
}

QToolButton {
    min-width: 30px;
    padding: 2px;
}

QPushButton:hover, QToolButton:hover {
    background: #2a3741;
    border-color: #65727b;
}

QPushButton:pressed, QToolButton:pressed {
    background: #51472d;
}

QPushButton:disabled, QToolButton:disabled {
    color: #68747b;
    background: #172029;
}

QListWidget::item {
    background: #1b2731;
    border: 1px solid #34434e;
    border-radius: 5px;
    margin: 3px;
    padding: 6px;
}

QListWidget::item:hover {
    background: #24313b;
}

QListWidget::item:selected {
    background: #4a412a;
    border-color: #b79a53;
}

QListWidget QWidget, QListWidget QLabel {
    background: transparent;
}

QHeaderView::section {
    background: #1c2730;
    color: #d7dfe2;
    border: 0;
    border-right: 1px solid #34434e;
    border-bottom: 1px solid #3d4c57;
    padding: 7px;
    font-weight: 600;
}

QTableWidget, QTreeWidget {
    gridline-color: #2d3b45;
}

QTableWidget::item, QTreeWidget::item {
    padding: 5px;
}

#WarningText {
    color: #c9905e;
    font-weight: 600;
}

QTabBar::tab {
    background: #18232c;
    color: #aeb8bd;
    border: 1px solid #34434e;
    padding: 8px 13px;
}

QTabBar::tab:selected {
    color: #ffffff;
    background: #332f24;
    border-bottom-color: #b79a53;
}

QSplitter::handle {
    background: #34434e;
    width: 1px;
}

QToolTip {
    background: #0b1117;
    color: #ffffff;
    border: 1px solid #65727b;
    padding: 5px;
}

#CompatibilityWarning {
    background: #302a1d;
    color: #d6bd7a;
    border: 1px solid #76643a;
    border-radius: 4px;
    padding: 8px;
}

#TaskThumbnail {
    background: #0c1218;
    border: 1px solid #34434e;
    border-radius: 4px;
}
